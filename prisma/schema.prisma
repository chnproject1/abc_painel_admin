generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id               String    @id
  nome             String
  telefone         String
  email            String
  plano            String    @default("")
  status           String    @default("pendente")
  estilo           String?
  letra            String?   @db.Text
  gerou_musica     Boolean   @default(false)
  link_pagina      String?
  link_basica      String?
  link_audio       String?
  song_id          String?
  data_entrega     DateTime?
  entrega_whatsapp Boolean   @default(false)
  entrega_email    Boolean   @default(false)
  erro_geracao     Boolean   @default(false)
  link_mp4         String?

  cpf              String    @default("00000000000")
  nomefiscal       String?
  funil            String?
  recovery_id      String?

  // Controle de emissão de nota fiscal (Spedy) — ver SPEDY.md
  nota_importada   Boolean   @default(false)
  nota_lote        String?

  // Visível apenas para admin
  data_pedido      DateTime?
  valor            Decimal?  @db.Decimal(10, 2)
  utm_source       String?
  utm_campaign     String?
  utm_medium       String?
  utm_content      String?
  utm_term         String?
  utm_id           String?
  fbclid           String?
  ttclid           String?
  pixel_id         String?
  ip               String?

  recuperacao       Int      @default(0)
  tentativa_geracao Int      @default(0)
  tentativa_envio   Int      @default(0)

  // Conversao ja registrada na UTMify. Os pagos anteriores foram marcados
  // true num backfill, entao o painel nasce sem pendencia acumulada.
  rastreado         Boolean  @default(false)

  criado_em        DateTime  @default(now())
  atualizado_em    DateTime  @updatedAt

  // Upsell de vídeo (fotos + música). Um por pedido, criado quando o n8n
  // monta a mensagem da música com o link do upsell.
  video            PedidoVideo?

  @@index([telefone])
  @@index([email])
  @@index([status])
}

// Upsell de vídeo — clipe vertical com as fotos do cliente e a música como
// trilha. Um por pedido (1:1 com Pedido). Nome, telefone e a URL da música
// (link_audio) ficam em Pedido; aqui só o que é do vídeo.
//
// Venda e produção em colunas separadas, como em Pedido: status conta a
// venda, producao diz em que ponto o pedido está.
//   status:   pendente -> pago
//   producao: aguardando_fotos -> fotos_enviadas -> renderizando -> concluido
//             (qualquer etapa pode cair em erro)
// Quem grava cada coluna: n8n (criação, render, entrega), página/Netlify
// (fotos, pagamento) — o portal só guarda e responde. Arquivos ficam no
// Supabase Storage (buckets públicos fotos/ e videos/); aqui vai só o path.
model PedidoVideo {
  pedido_id String @id // pix_char da música (= Pedido.id)
  pedido    Pedido @relation(fields: [pedido_id], references: [id])

  token    String @unique // aleatório, vai no link /upvideo/?t=
  status   String @default("pendente") // venda: pendente | pago
  producao String @default("aguardando_fotos")

  // Fotos do cliente: [{path, w, h, ordem}] — path = fotos/<token>/1.jpg
  fotos      Json     @default("[]")
  opcoes     Json     @default("{}") // {card_nome: true}
  musica_seg Decimal? @db.Decimal(8, 2) // duração da música (ffprobe), preenchida no render

  // Arquivos gerados (bucket videos/)
  video_path    String? // videos/<token>/final.mp4     1080x1920
  whatsapp_path String? // videos/<token>/whatsapp.mp4  720p, até 16 MB

  // Pagamento do upsell (PIX próprio, diferente do da música)
  pagamento_id String?  @unique // pix_char do PIX do vídeo
  valor        Decimal? @db.Decimal(10, 2)

  // Entrega e erro
  entrega_whatsapp Boolean @default(false)
  erro_msg         String?
  tentativas       Int     @default(0)

  // Origem do clique no link do upsell (canal da mensagem), separada da
  // origem da compra da música que está em Pedido.
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  utm_term     String?

  // Linha do tempo — é daqui que sai o funil do upsell (enviado > aberto >
  // fotos > pago > concluído)
  enviado_em    DateTime? // link foi na mensagem da música
  aberto_em     DateTime? // cliente abriu o link
  fotos_em      DateTime?
  pago_em       DateTime?
  concluido_em  DateTime?
  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  @@index([status])
  @@index([producao])
  @@index([criado_em])
}

// Operação Estados Unidos — mesma função do model Pedido, colunas próprias.
// Sem telefone/WhatsApp (contato só por email) e sem campos fiscais brasileiros.
// Funil: venda inicial -> up1 (página Premium) -> up2 (2 músicas extras)
//        -> ds (página Premium, só aparece se up1 e up2 forem recusados)
model PedidoUs {
  id            String    @id                  // ID da cobrança no Stripe (o mesmo durante toda a compra)

  nome          String
  email         String
  nomefiscal    String?                        // nome fiscal informado no funil
  comprador     String?                        // nome impresso no cartão (Stripe)
  zip_code      String?                        // CEP de cobrança (Stripe / AVS)
  pais          String?   @default("US")
  plano         String    @default("")         // basic | basic_up1 | basic_up2 | basic_up1_up2 | basic_ds (idem silver)
  idioma        String    @default("en")

  // Status por oferta — pendente | pago | recusado
  status        String    @default("pendente") // venda inicial
  up1_status    String?                        // upsell 1 — página Premium
  up2_status    String?                        // upsell 2 — duas músicas extras
  ds_status     String?                        // downsell — página Premium

  estilo        String?
  letra         String?   @db.Text

  // Entrega principal: música 1 + página Premium (se up1 ou ds pago)
  gerou_musica  Boolean   @default(false)
  erro_geracao  Boolean   @default(false)
  song_id       String?
  link_audio    String?
  link_basica   String?
  link_pagina   String?
  link_mp4      String?
  data_entrega  DateTime?
  entrega_email Boolean   @default(false)
  tentativa_geracao Int   @default(0)
  tentativa_envio   Int   @default(0)

  // Entrega da página Premium (liberada por up1 ou ds) — vai em e-mail
  // separado, disparado pelo fluxo seguinte ao da música principal
  pagina_entrega_email Boolean @default(false)
  pagina_data_entrega  DateTime?

  // Entrega do upsell 2: músicas 2 e 3 (+ páginas, se up1 ou ds pago)
  up_gerou_musica Boolean @default(false)
  up_erro_geracao Boolean @default(false)
  song_id2      String?
  link_audio2   String?
  link_basica2  String?
  link_pagina2  String?
  song_id3      String?
  link_audio3   String?
  link_basica3  String?
  link_pagina3  String?
  up_data_entrega   DateTime?
  up_entrega_email  Boolean @default(false)
  up_tentativa_geracao Int  @default(0)
  up_tentativa_envio   Int  @default(0)

  // Registro bruto vindo do funil (Netlify). O painel deriva daqui os
  // up1_status / up2_status / ds_status e os valores por oferta.
  // Mapeamento: pagina = up1, versoes = up2, combo = ds (entrega as duas).
  upsell            String?                    // 'pagina' | 'versoes' | 'pagina,versoes'
  upsell_status     String?                    // pago | recusado
  upsell_amount     String?                    // '12.00' ou '12.00,9.00'
  upsell_payment_id String?                    // 'pi_...' ou 'pi_...,pi_...'
  upsell_erro       String?
  upsell_n8n        String?

  // Recuperação de carrinho
  funil         String?
  recovery_id   String?
  recuperacao   Int       @default(0)

  // Visível apenas para admin
  data_pedido   DateTime?
  valor         Decimal?  @db.Decimal(10, 2)   // venda inicial, em USD
  up1_valor     Decimal?  @db.Decimal(10, 2)
  up2_valor     Decimal?  @db.Decimal(10, 2)
  ds_valor      Decimal?  @db.Decimal(10, 2)

  utm_source    String?
  utm_campaign  String?
  utm_medium    String?
  utm_content   String?
  utm_term      String?
  utm_id        String?
  fbclid        String?
  ttclid        String?
  pixel_id      String?
  ip            String?

  // Cookies e user-agent do navegador. Pesam mais que o fbclid no pareamento
  // do Meta CAPI e do TikTok Events API — o fbc remontado a partir do fbclid
  // carrega o timestamp do pagamento, não o do clique.
  fbp           String?
  ttp           String?
  user_agent    String?

  criado_em     DateTime  @default(now())
  atualizado_em DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([plano])
  @@index([data_pedido])
}

model Usuario {
  id       String  @id @default(cuid())
  email    String  @unique
  senha    String
  nome     String
  role     Role    @default(OPERADOR)
  ativo    Boolean @default(true)
}

enum Role {
  ADMIN
  OPERADOR
  PRODUTOR
}
